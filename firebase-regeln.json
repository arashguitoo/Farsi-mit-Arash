{
  "rules": {
    "farsi": {
      "klassen": {
        ".read": true,
        ".write": "auth != null"
      },
      "freigabe": {
        ".read": true,
        ".write": "auth != null"
      },
      "tn": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$code": {
          ".read": true
        }
      },
      "fortschritt": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$code": {
          ".read": true,
          ".write": "auth != null || root.child('farsi/tn/' + $code).exists()"
        }
      },
      "korrekturen": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "termine": {
        ".read": true,
        ".write": "auth != null"
      },
      "anwesenheit": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$klasse": {
          "$termin": {
            "$code": {
              ".read": true,
              ".write": "auth != null || (root.child('farsi/tn/' + $code + '/klasse').val() === $klasse && root.child('farsi/tn/' + $code + '/aktiv').val() !== false && root.child('farsi/termine/' + $klasse + '/' + $termin).exists() && newData.child('s').val() === 'gemeldet' && (!data.exists() || data.child('s').val() === 'gemeldet'))"
            }
          }
        }
      },
      "live": {
        "$spiel": {
          ".read": "auth != null",
          ".indexOn": [
            "erstellt"
          ],
          "$code": {
            ".read": true,
            ".write": "auth != null || (!data.exists() && newData.child('host').exists() && root.child('farsi/tn/' + newData.child('host').val()).exists()) || (data.child('host').exists() && newData.child('host').val() === data.child('host').val())",
            "spieler": {
              "$pid": {
                ".write": "root.child('farsi/live/' + $spiel + '/' + $code + '/phase').exists()"
              }
            },
            "teams": {
              "$team": {
                ".write": "root.child('farsi/live/' + $spiel + '/' + $code + '/phase').val() === 'spiel'"
              }
            }
          }
        }
      },
      "schreiben": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$code": {
          ".read": true,
          "$aufgabe": {
            "tn": {
              ".write": "auth != null || root.child('farsi/tn/' + $code).exists()"
            }
          }
        }
      },
      "meldungen": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$id": {
          ".write": "auth != null || (!data.exists() && newData.child('text').isString() && newData.child('text').val().length <= 1500 && newData.child('status').val() === 'neu')"
        }
      },
      "netz": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$raum": {
          "ok": {
            ".read": true
          },
          "mitglieder": {
            ".read": true,
            "$pid": {
              ".write": "root.child('farsi/netz/' + $raum + '/ok').val() === true && newData.child('name').isString() && newData.child('name').val().length <= 20"
            }
          },
          "frei": {
            ".read": true,
            "$id": {
              "reakt": {
                "$pid": {
                  ".write": "!newData.exists() || (newData.isString() && newData.val().length < 8)"
                }
              },
              "kom": {
                "$pid": {
                  ".write": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() < 20)"
                }
              },
              "tipps": {
                "$pid": {
                  ".write": "newData.isString() && newData.val().length < 40"
                }
              }
            }
          },
          "eingang": {
            "$id": {
              ".write": "!data.exists() && root.child('farsi/netz/' + $raum + '/ok').val() === true && newData.hasChildren(['pid', 'name', 'typ', 'bild', 'ts']) && newData.child('bild').isString() && newData.child('bild').val().length < 500000 && (!newData.child('text').exists() || newData.child('text').val().length <= 400)"
            }
          }
        }
      }
    }
  }
}