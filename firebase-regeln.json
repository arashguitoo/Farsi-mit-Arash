{
  "rules": {
    "farsi": {
      "klassen": {
        ".read": true,
        ".write": "auth != null"
      },
      "freigabe": {
        ".read": true,
        ".write": "auth != null"
      },
      "tn": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$code": {
          ".read": true
        }
      },
      "fortschritt": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$code": {
          ".read": true,
          ".write": "auth != null || root.child('farsi/tn/' + $code).exists()"
        }
      },
      "korrekturen": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "termine": {
        ".read": true,
        ".write": "auth != null"
      },
      "anwesenheit": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$klasse": {
          "$termin": {
            "$code": {
              ".read": true,
              ".write": "auth != null || (root.child('farsi/tn/' + $code + '/klasse').val() === $klasse && root.child('farsi/tn/' + $code + '/aktiv').val() !== false && root.child('farsi/termine/' + $klasse + '/' + $termin).exists() && newData.child('s').val() === 'gemeldet' && (!data.exists() || data.child('s').val() === 'gemeldet'))"
            }
          }
        }
      },
      "live": {
        "$spiel": {
          ".read": "auth != null",
          ".indexOn": [
            "erstellt"
          ],
          "$code": {
            ".read": true,
            ".write": "auth != null || (!data.exists() && newData.child('host').exists() && root.child('farsi/tn/' + newData.child('host').val()).exists()) || (data.child('host').exists() && newData.child('host').val() === data.child('host').val())",
            "spieler": {
              "$pid": {
                ".write": "root.child('farsi/live/' + $spiel + '/' + $code + '/phase').exists()"
              }
            },
            "teams": {
              "$team": {
                ".write": "root.child('farsi/live/' + $spiel + '/' + $code + '/phase').val() === 'spiel'"
              }
            }
          }
        }
      }
    }
  }
}